{
  "name": "n8n-nodes-relayfile",
  "version": "0.1.0",
  "description": "n8n community nodes for RelayFile workspaces",
  "license": "MIT",
  "homepage": "https://github.com/AgentWorkforce/relayfile",
  "repository": {
    "type": "git",
    "url": "https://github.com/AgentWorkforce/n8n-nodes-relayfile"
  },
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "relayfile",
    "filesystem",
    "automation"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18.17"
  },
  "peerDependencies": {
    "n8n-workflow": "^2.13.1"
  },
  "dependencies": {
    "@relayfile/sdk": "^0.1.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "n8n-workflow": "^2.13.1",
    "typescript": "^5.8.2"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "n8nNodesPackageName": "n8n-nodes-relayfile",
    "credentials": [
      "dist/credentials/RelayfileApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Relayfile/Relayfile.node.js",
      "dist/nodes/Relayfile/RelayfileTrigger.node.js",
      "dist/nodes/Relayfile/RelayfileOps.node.js"
    ]
  }
}
